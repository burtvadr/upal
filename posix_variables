#!/bin/sh
# SPDX-License-Identifier: 0BSD
# POSIX generic portable application script

# Directory where this script lives
PORTABLE_ROOT=$(cd -P -- "$(dirname -- "$0")" && command pwd -P)

# Variables
PACKAGE_MANAGER="auto"
PKG=""
NAME="$PKG"
DAT_SOURCE="$PORTABLE_ROOT/dat"
DAT_TARGET="" 
BACKUP="yes"
BIN_SOURCE="$PORTABLE_ROOT/bin"
BIN_TARGET=""
DESKTOP_FILE_NAME=""
DESKTOP_FILE_SOURCE="$PORTABLE_ROOT"
DESKTOP_FILE_TARGET="$HOME/.local/share/applications"
DESKTOP_REWRITE_EXEC="yes"
# Multi-entry suites: name|bindir|executable|desktop|icon|icon_id
ENTRIES=""
DEFAULT_ENTRY=""
LAUNCHER=""
ICON_NAME=""
ICON_ID=""
ICON_SOURCE="$PORTABLE_ROOT"
ICON_TARGET=""
ICON_METHOD="copy"
ICON=""
CACHE_SOURCE="" 
CACHE_TARGET="" 
MAN="$BIN_SOURCE"
KILL_TERMINAL="yes"

# Runtime paths and privileges
SELF=$PORTABLE_ROOT/$(basename -- "$0")
ORIG_USER=${SUDO_USER:-${DOAS_USER:-}}
ORIG_UID=${SUDO_UID:-${DOAS_UID:-}}
ORIG_GID=${SUDO_GID:-${DOAS_GID:-}}
if [ "$(id -u)" -eq 0 ] && [ -n "$ORIG_USER" ] && [ "$ORIG_USER" != "root" ]; then
    ORIG_HOME=$(getent passwd "$ORIG_USER" 2>/dev/null | cut -d: -f6)
    [ -n "$ORIG_HOME" ] || ORIG_HOME=$(awk -F: -v u="$ORIG_USER" '$1 == u { print $6; exit }' /etc/passwd)
    [ -n "$ORIG_HOME" ] && HOME="$ORIG_HOME"
fi
if [ -z "$ORIG_UID" ] && [ -n "$ORIG_USER" ]; then
    ORIG_UID=$(id -u "$ORIG_USER" 2>/dev/null)
    ORIG_GID=$(id -g "$ORIG_USER" 2>/dev/null)
fi

# Suggest an escalator without invoking it
if command -v sudo >/dev/null 2>&1; then
    ESCALATOR=sudo
elif command -v doas >/dev/null 2>&1; then
    ESCALATOR=doas
else
    ESCALATOR=""
fi

# Fail instead of calling sudo
need_root() {
    if [ "$(id -u)" -eq 0 ]; then
        printf '%s\n' "Failed: $*" >&2
    else
        printf '%s\n' "This needs root: $*" >&2
        printf '%s\n' "Re-run as root: ${ESCALATOR:+$ESCALATOR }$0" >&2
    fi
    exit 1
}

# Keep files under the invoking user's home owned by that user
own() {
    [ "$(id -u)" -eq 0 ] && [ -n "$ORIG_UID" ] && [ -n "$ORIG_GID" ] || return 0
    case "$1" in
        "$HOME"/*) chown -h "$ORIG_UID:$ORIG_GID" "$1" 2>/dev/null || true ;;
    esac
}

# Keep the created parent chain under the invoking user's home owned by that user
own_path() {
    [ "$(id -u)" -eq 0 ] && [ -n "$ORIG_UID" ] && [ -n "$ORIG_GID" ] || return 0
    _p=$1
    while [ -n "$_p" ] && [ "$_p" != "/" ] && [ "$_p" != "$HOME" ]; do
        case "$_p" in
            "$HOME"/*) chown -h "$ORIG_UID:$ORIG_GID" "$_p" 2>/dev/null || true ;;
            *) break ;;
        esac
        _p=$(dirname -- "$_p")
    done
}

# sed -i that keeps the original owner (useful when run with sudo)
sed_in_place() {
    _file=$1
    shift
    _uid=$(stat -c %u -- "$_file" 2>/dev/null)
    _gid=$(stat -c %g -- "$_file" 2>/dev/null)
    sed -i "$@" "$_file" || need_root "edit $_file"
    if [ "$(id -u)" -eq 0 ] && [ -n "$_uid" ] && [ -n "$_gid" ]; then
        chown "$_uid:$_gid" -- "$_file" 2>/dev/null
    fi
}

# Remember the last installed icon so an auto-detected icon can be restored
# after its source file is deleted.
_state_base="${XDG_STATE_HOME:-$HOME/.local/state}/upal"
_icon_key=${PKG:-${NAME:-$(printf '%s' "$PORTABLE_ROOT" | cksum | cut -d' ' -f1)}}
_icon_key=$(printf '%s' "$_icon_key" | tr -c 'A-Za-z0-9._-' '_')
_icon_state="$_state_base/icon-$_icon_key"
_source_key=$(stat -c '%d-%i' "$PORTABLE_ROOT" 2>/dev/null) || _source_key=$(printf '%s' "$PORTABLE_ROOT" | cksum | cut -d' ' -f1)

icon_state_field() {
    [ -f "$_icon_state" ] || return 1
    _v=$(sed -n "${1}p" "$_icon_state" 2>/dev/null)
    [ -n "$_v" ] || return 1
    printf '%s' "$_v"
}

icon_state_save() {
    _id=$1
    _ext=$2
    _dir=$3
    [ -n "$_id" ] && [ -n "$_ext" ] && [ -n "$_dir" ] || return 0
    _def=$(icon_state_field 4) || _def=$_ext
    _defdir=$(icon_state_field 5) || _defdir=$_dir
    mkdir -p "$(dirname -- "$_icon_state")" || need_root "create $(dirname -- "$_icon_state")"
    printf '%s\n%s\n%s\n%s\n%s\n' "$_id" "$_ext" "$_dir" "$_def" "$_defdir" > "$_icon_state" || need_root "write $_icon_state"
    own "$_icon_state"
}

icon_state_load() {
    [ -f "$_icon_state" ] || return 1
    _def=""
    _defdir=""
    {
        IFS= read -r _id || return 1
        IFS= read -r _ext || return 1
        IFS= read -r _dir || return 1
        IFS= read -r _def || _def=""
        IFS= read -r _defdir || _defdir=""
    } < "$_icon_state" || return 1
    [ -n "$_id" ] && [ -n "$_ext" ] && [ -n "$_dir" ] || return 1
    ICON_ID=$_id
    _icon_ext=$_ext
    ICON_TARGET=$_dir
    _icon_default_ext=$_def
    _icon_default_dir=$_defdir
}

# Managed source directories are remembered by device, inode, and top-level
# names, so a directory renamed inside the portable root can be found again.
# State lives outside the root and is keyed by the root path.
source_state_file() {
    printf '%s/source-%s-%s' "$_state_base" "$_source_key" "$1"
}

source_state_save() {
    _role=$1
    _path=$2
    [ -d "$_path" ] && [ ! -L "$_path" ] || return 0
    _dev=$(stat -c %d -- "$_path" 2>/dev/null) || return 0
    _ino=$(stat -c %i -- "$_path" 2>/dev/null) || return 0
    _file=$(source_state_file "$_role")
    mkdir -p "$_state_base" || need_root "create $_state_base"
    own_path "$_state_base"
    {
        printf '%s %s\n' "$_dev" "$_ino"
        for _entry in "$_path"/* "$_path"/.[!.]* "$_path"/..?*; do
            [ -e "$_entry" ] || [ -L "$_entry" ] || continue
            if [ -L "$_entry" ]; then
                _kind=l
            elif [ -d "$_entry" ]; then
                _kind=d
            elif [ -f "$_entry" ]; then
                _kind=f
            else
                _kind=o
            fi
            printf '%s %s\n' "$_kind" "${_entry##*/}"
        done | LC_ALL=C sort
    } > "$_file" || need_root "write $_file"
    own "$_file"
}

# An empty state file marks a source that was known but is now missing, so a
# later run does not mistake it for a first run and create an empty directory.
source_state_mark_missing() {
    _role=$1
    _file=$(source_state_file "$_role")
    [ -f "$_file" ] && return 0
    mkdir -p "$_state_base" || need_root "create $_state_base"
    own_path "$_state_base"
    : > "$_file" || need_root "write $_file"
    own "$_file"
}

# source_score <state_file> <candidate>
# Sets _score, _match, and _total from the top-level names in the state.
source_score() {
    _file=$1
    _cand=$2
    _total=0
    _match=0
    _header=1
    while IFS= read -r _entry || [ -n "$_entry" ]; do
        if [ "$_header" = "1" ]; then
            _header=0
            continue
        fi
        [ -n "$_entry" ] || continue
        _kind=${_entry%% *}
        _name=${_entry#* }
        [ -n "$_name" ] || _name=$_entry
        _total=$((_total + 1))
        case "$_kind" in
            d) [ -d "$_cand/$_name" ] && _match=$((_match + 1)) ;;
            f) [ -f "$_cand/$_name" ] && _match=$((_match + 1)) ;;
            l) [ -L "$_cand/$_name" ] && _match=$((_match + 1)) ;;
            *) { [ -e "$_cand/$_name" ] || [ -L "$_cand/$_name" ]; } && _match=$((_match + 1)) ;;
        esac
    done < "$_file"
    _score=0
    [ "$_total" -gt 0 ] && _score=$((100 * _match / _total))
    return 0
}

# source_consider <state_file> <candidate>
# An exact device/inode match wins. Otherwise at least two top-level names must
# match, and the best candidate must beat the second best by a clear margin.
source_consider() {
    _file=$1
    _cand=$2
    [ -d "$_cand" ] && [ ! -L "$_cand" ] || return 0
    case "$_cand/" in
        "$PORTABLE_ROOT"/*) ;;
        *) return 0 ;;
    esac
    _cdev=$(stat -c %d -- "$_cand" 2>/dev/null) || return 0
    _cino=$(stat -c %i -- "$_cand" 2>/dev/null) || return 0
    if [ -n "$_sino" ] && [ "$_cdev" = "$_sdev" ] && [ "$_cino" = "$_sino" ]; then
        _inode_hits=$((_inode_hits + 1))
        _inode_path=$_cand
        return 0
    fi
    source_score "$_file" "$_cand"
    [ "$_total" -ge 2 ] || return 0
    [ "$_match" -ge 2 ] || return 0
    if [ "$_score" -gt "$_best_score" ]; then
        _second_score=$_best_score
        _second_path=$_best_path
        _best_score=$_score
        _best_path=$_cand
    elif [ "$_cand" != "$_best_path" ] && [ "$_score" -gt "$_second_score" ]; then
        _second_score=$_score
        _second_path=$_cand
    fi
    return 0
}

source_missing() {
    _role=$1
    _path=$2
    _detail=$3
    case "$_role" in
        dat)     _label="data directory" ;;
        bin)     _label="binary directory" ;;
        desktop) _label="desktop file directory" ;;
        *)       _label="source directory" ;;
    esac
    printf 'Missing %s: %s\n' "$_label" "$_path" >&2
    [ -n "$_detail" ] && printf '%s\n' "$_detail" >&2
    printf 'Rename it back or set the matching path in the header.\n' >&2
    printf 'To start fresh, remove %s.\n' "$(source_state_file "$_role")" >&2
}

# source_relocate <role> <path> [target_link]
# Sets RESOLVED. A missing source with prior state is matched by inode, then by
# top-level name overlap. A broken target link is removed with rm -f, which
# unlinks the link itself and never follows it.
source_relocate() {
    _role=$1
    _path=$2
    _target=$3
    RESOLVED=$_path
    _file=$(source_state_file "$_role")

    if [ -e "$_path" ] || [ -L "$_path" ]; then
        source_state_save "$_role" "$_path"
        return 0
    fi

    _had_broken=0
    _target_link=0
    if [ -n "$_target" ] && [ -L "$_target" ]; then
        _target_link=1
        if [ ! -e "$_target" ]; then
            _had_broken=1
            rm -f -- "$_target" || need_root "remove the broken link $_target"
        fi
    fi

    if [ ! -f "$_file" ]; then
        if [ "$_had_broken" = "1" ]; then
            source_state_mark_missing "$_role"
            source_missing "$_role" "$_path" "The target link was removed; the source is gone."
            exit 1
        fi
        if [ "$_target_link" = "1" ]; then
            source_state_mark_missing "$_role"
            source_missing "$_role" "$_path" "The target is still a valid link; refusing to replace it with an empty source."
            exit 1
        fi
        return 0
    fi

    _sdev=""
    _sino=""
    if [ -s "$_file" ]; then
        IFS=' ' read -r _sdev _sino < "$_file" || :
    fi

    _inode_hits=0
    _inode_path=""
    _best_path=""
    _best_score=0
    _second_path=""
    _second_score=0

    _parent=$(dirname -- "$_path")
    _parent=$(cd -P -- "$_parent" 2>/dev/null && pwd -P) || _parent=""
    if [ -n "$_parent" ]; then
        while IFS= read -r _cand; do
            source_consider "$_file" "$_cand"
        done <<EOF
$(find "$_parent" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null)
EOF
    fi

    if [ "$_inode_hits" -eq 0 ]; then
        # An exact inode match is unique. Otherwise scan the whole root so a
        # deeper copy cannot hide behind a confident sibling match.
        # shortcut: moved renames are searched three levels deep; deeper moves
        # need an explicit source path.
        while IFS= read -r _cand; do
            source_consider "$_file" "$_cand"
        done <<EOF
$(find "$PORTABLE_ROOT" -mindepth 1 -maxdepth 3 -type d -print 2>/dev/null)
EOF
    fi

    if [ "$_inode_hits" -eq 1 ]; then
        RESOLVED=$_inode_path
    elif [ "$_inode_hits" -gt 1 ]; then
        source_missing "$_role" "$_path" "More than one directory has the old identity."
        exit 1
    elif [ "$_best_score" -ge 65 ] && [ "$_best_score" -ge $((_second_score + 15)) ]; then
        RESOLVED=$_best_path
    else
        _detail=""
        if [ -n "$_best_path" ]; then
            _detail="Closest candidate: $_best_path ($_best_score% name match, second $_second_score%)."
        fi
        source_missing "$_role" "$_path" "$_detail"
        exit 1
    fi

    source_state_save "$_role" "$RESOLVED"
    [ "${UPAL_VERBOSE:-}" = "1" ] && printf 'Using %s: %s\n' "$_role" "$RESOLVED" >&2
}

# Repair managed sources renamed inside the portable root before using them.
if [ -n "$DAT_SOURCE" ]; then
    source_relocate dat "$DAT_SOURCE" "$DAT_TARGET"
    DAT_SOURCE=$RESOLVED
fi
_old_bin=""
if [ -n "$BIN_SOURCE" ] && [ -z "$ENTRIES" ]; then
    _bin_before=$BIN_SOURCE
    source_relocate bin "$BIN_SOURCE"
    BIN_SOURCE=$RESOLVED
    [ "$BIN_SOURCE" != "$_bin_before" ] && _old_bin=$_bin_before
    [ "$MAN" = "$_bin_before" ] && MAN=$BIN_SOURCE
fi
if [ -n "$DESKTOP_FILE_SOURCE" ] && [ "$DESKTOP_FILE_SOURCE" != "$PORTABLE_ROOT" ] && [ -z "$ENTRIES" ]; then
    source_relocate desktop "$DESKTOP_FILE_SOURCE"
    DESKTOP_FILE_SOURCE=$RESOLVED
fi

# Icon archives: <target>1, <target>2, ...
# The oldest archive is the icon to restore when the custom icon is removed.
icon_oldest() {
    _tgt=$1
    _best=""
    _bestn=0
    for _f in "$_tgt"[0-9]*; do
        [ -e "$_f" ] || [ -L "$_f" ] || continue
        _n=${_f#"$_tgt"}
        case "$_n" in ''|*[!0-9]*) continue ;; esac
        if [ -z "$_best" ] || [ "$_n" -lt "$_bestn" ]; then
            _bestn=$_n
            _best=$_f
        fi
    done
    printf '%s\n' "$_best"
}

icon_newest() {
    _tgt=$1
    _best=""
    _bestn=0
    for _f in "$_tgt"[0-9]*; do
        [ -e "$_f" ] || [ -L "$_f" ] || continue
        _n=${_f#"$_tgt"}
        case "$_n" in ''|*[!0-9]*) continue ;; esac
        if [ "$_n" -gt "$_bestn" ]; then
            _bestn=$_n
            _best=$_f
        fi
    done
    printf '%s\n' "$_best"
}

icon_backup() {
    _tgt=$1
    [ -e "$_tgt" ] || [ -L "$_tgt" ] || return 0
    _first=$(icon_oldest "$_tgt")
    if [ -n "$_first" ] && cmp -s "$_tgt" "$_first"; then
        return 0
    fi
    _last=$(icon_newest "$_tgt")
    if [ -n "$_last" ]; then
        _n=$((${_last#"$_tgt"} + 1))
    else
        _n=1
    fi
    if [ -L "$_tgt" ]; then
        [ -e "$_tgt" ] || { rm -f "$_tgt"; return 0; }
        cp -Lf "$_tgt" "$_tgt$_n" || need_root "back up $_tgt to $_tgt$_n"
        rm -f "$_tgt" || need_root "remove $_tgt"
    else
        mv "$_tgt" "$_tgt$_n" || need_root "back up $_tgt to $_tgt$_n"
    fi
}

# Archive an active icon, then drop it if it was an identical copy of the
# oldest archive and the backup skipped it.
icon_archive_active() {
    _p=$1
    [ -e "$_p" ] || [ -L "$_p" ] || return 0
    icon_backup "$_p"
    [ -e "$_p" ] || [ -L "$_p" ] || return 0
    rm -f "$_p" || need_root "remove $_p"
}

icon_install() {
    _src=$1
    _new=$2
    [ -e "$_src" ] || return 1
    _dir=$(dirname -- "$_new")
    mkdir -p "$_dir" || need_root "create $_dir"
    own_path "$_dir"

    _base=${_new%.*}
    _ext=${_new##*.}
    _id=${_base##*/}
    # A renamed icon can change format and directory. Archive the active icon
    # in the other standard theme directory so it stays available as default.
    case "$_dir" in
        "$HOME/.local/share/icons/hicolor/scalable/apps")
            _other="$HOME/.local/share/icons/hicolor/256x256/apps" ;;
        "$HOME/.local/share/icons/hicolor/256x256/apps")
            _other="$HOME/.local/share/icons/hicolor/scalable/apps" ;;
        *) _other="" ;;
    esac
    if [ -n "$_other" ]; then
        for _e in svg png xpm jpg jpeg; do
            _old="$_other/$_id.$_e"
            if [ -e "$_old" ] || [ -L "$_old" ]; then
                icon_archive_active "$_old"
            fi
        done
    fi
    # A renamed icon can change format in the same directory.
    for _e in svg png xpm jpg jpeg; do
        [ "$_e" = "$_ext" ] && continue
        _old="$_base.$_e"
        if [ -e "$_old" ] || [ -L "$_old" ]; then
            icon_archive_active "$_old"
        fi
    done

    if [ -e "$_new" ] || [ -L "$_new" ]; then
        if [ "$_new" -ef "$_src" ]; then
            return 0
        elif [ "$ICON_METHOD" != "link" ] && cmp -s "$_src" "$_new"; then
            return 0
        fi
    fi

    icon_backup "$_new"
    if [ "$ICON_METHOD" = "link" ]; then
        ln -sfn "$_src" "$_new" || need_root "link $_new"
    else
        cp -f "$_src" "$_new" || need_root "copy $_src to $_new"
    fi
    own "$_new"
}

# icon_restore <dir> <id> [default_ext] [default_dir]
# Bring back the default icon, or remove the managed one when there is none.
# The default directory and extension survive format changes, and the oldest
# archive stays in place, so later runs keep restoring the same icon.
icon_restore() {
    _dir=$1
    _id=$2
    _defext=$3
    _defdir=$4
    [ -n "$_defext" ] || _defext=${_icon_default_ext:-$_icon_ext}
    [ -n "$_defdir" ] || _defdir=${_icon_default_dir:-$_dir}
    _first=""
    [ -n "$_defext" ] && _first=$(icon_oldest "$_defdir/$_id.$_defext")
    if [ -n "$_first" ]; then
        _active="$_defdir/$_id.$_defext"
        if [ ! -e "$_active" ] || ! cmp -s "$_first" "$_active"; then
            rm -f "$_active" || need_root "replace $_active"
            cp -f "$_first" "$_active" || need_root "restore $_first to $_active"
        fi
        own "$_active"
        # Drop the active icon from the other directory and format
        if [ "$_dir" != "$_defdir" ]; then
            rm -f "$_dir/$_id.$_icon_ext" 2>/dev/null
        fi
        for _d in "$_defdir" "$_dir"; do
            for _e in svg png xpm jpg jpeg; do
                [ "$_d" = "$_defdir" ] && [ "$_e" = "$_defext" ] && continue
                rm -f "$_d/$_id.$_e" 2>/dev/null
            done
        done
        # Drop every archive except the default one
        for _d in "$_defdir" "$_dir"; do
            for _e in svg png xpm jpg jpeg; do
                for _f in "$_d/$_id.$_e"[0-9]*; do
                    [ -e "$_f" ] || [ -L "$_f" ] || continue
                    [ "$_f" = "$_first" ] && continue
                    rm -f "$_f" || need_root "remove $_f"
                done
            done
        done
    else
        for _d in "$_defdir" "$_dir"; do
            for _e in svg png xpm jpg jpeg; do
                rm -f "$_d/$_id.$_e" 2>/dev/null
            done
        done
    fi
}

# Map a file's MIME type to a theme icon extension
icon_mime_ext() {
    case "$(file -b --mime-type -- "$1" 2>/dev/null)" in
        image/svg+xml)                 printf 'svg' ;;
        image/png)                     printf 'png' ;;
        image/x-xpixmap|image/x-xpm)   printf 'xpm' ;;
        image/jpeg)                    printf 'jpg' ;;
    esac
}

# A single image in ICON_SOURCE becomes the icon; ICON_NAME pins one.
# Filenames and extensions do not matter, the MIME type does. More than one
# image is ambiguous, so the default icon is kept.
_icon_auto=""
if [ -z "$ICON_NAME" ] && [ -d "$ICON_SOURCE" ]; then
    _icon_count=0
    _icon_ext_found=""
    for f in "$ICON_SOURCE"/*; do
        [ -f "$f" ] || continue
        case "$(file -b --mime-type -- "$f" 2>/dev/null)" in
            image/*) ;;
            *) continue ;;
        esac
        _icon_count=$((_icon_count + 1))
        _icon_first=$f
        _icon_ext_found=$(icon_mime_ext "$f")
    done
    if [ "$_icon_count" -eq 1 ] && [ -n "$_icon_ext_found" ]; then
        ICON_NAME=${_icon_first##*/}
        _icon_auto=1
    fi
fi
if [ -n "$ICON_NAME" ]; then
    ICON="$ICON_SOURCE/$ICON_NAME"
    _icon_ext=$(icon_mime_ext "$ICON")
    if [ -z "$_icon_ext" ]; then
        _icon_ext=${ICON_NAME##*.}
        case "$_icon_ext" in
            svg|png|xpm|jpg|jpeg) ;;
            *) _icon_ext=png ;;
        esac
    fi
    if [ -z "$ICON_ID" ]; then
        [ "$_icon_auto" = "1" ] && ICON_ID=${PKG:-$NAME}
        [ -n "$ICON_ID" ] || ICON_ID=${ICON_NAME%.*}
    fi
    case "$ICON_ID" in
        *.svg|*.png|*.xpm|*.jpg|*.jpeg) ICON_ID=${ICON_ID%.*} ;;
    esac
    case "$_icon_ext" in
        svg) _icon_dir="scalable/apps" ;;
        *) _icon_dir="256x256/apps" ;;
    esac
    if [ -z "$ICON_TARGET" ]; then
        ICON_TARGET="$HOME/.local/share/icons/hicolor/$_icon_dir"
    fi
    # A pinned icon can be renamed or its format changed; use the last
    # installed location so the old active icon is cleaned up on restore.
    if [ ! -e "$ICON" ]; then
        _prev_dir=$(icon_state_field 3) || _prev_dir=""
        _prev_ext=$(icon_state_field 2) || _prev_ext=""
        [ -n "$_prev_dir" ] && ICON_TARGET=$_prev_dir
        [ -n "$_prev_ext" ] && _icon_ext=$_prev_ext
    fi
elif [ -z "$ICON" ]; then
    # No source icon: recover the last installed icon so it can be restored
    icon_state_load || :
fi

# The default icon identity survives renames and format changes
_icon_default_ext=$(icon_state_field 4) || _icon_default_ext=""
_icon_default_dir=$(icon_state_field 5) || _icon_default_dir=""

# Check whether any target path is on a filesystem without POSIX permission support
paths="
$DAT_SOURCE
$BIN_SOURCE
$DESKTOP_FILE_SOURCE
$ICON_SOURCE
$CACHE_SOURCE
$MAN
"

# Language-based directory name assumptions
LANG_INFERRING_BIN="bin binary binaries binarios executables executável executáveis executaveis executavel"
LANG_INFERRING_DATA="dat data dados config user"

# Check whether any target path is on a filesystem without POSIX permission support
printf '%s\n' "$paths" | while IFS= read -r path; do
    [ -z "$path" ] && continue

    fstype=$(findmnt -n -o FSTYPE -T "$path" 2>/dev/null) || continue

    case "$fstype" in
        ntfs|ntfs3|fuseblk|vfat|msdos|exfat)
            notify-send "Warning" "'$path' is on a $fstype filesystem."
            kill -TERM "$PPID"
            ;;
    esac
done

# Install the package if not already installed
# PACKAGE_MANAGER: "auto"/"native" tries pkgcli > pkcon > distro; "distro" uses only the distro package manager
if [ -n "$PKG" ]; then
    if command -v "$PKG" >/dev/null 2>&1; then
        : # already installed
    elif { [ "$PACKAGE_MANAGER" = "auto" ] || [ "$PACKAGE_MANAGER" = "native" ]; } && command -v pkgcli >/dev/null 2>&1; then
        pkgcli install "$PKG"
    elif { [ "$PACKAGE_MANAGER" = "auto" ] || [ "$PACKAGE_MANAGER" = "native" ]; } && command -v pkcon >/dev/null 2>&1; then
        pkcon install "$PKG"
    elif [ "$PACKAGE_MANAGER" = "auto" ] || [ "$PACKAGE_MANAGER" = "native" ] || [ "$PACKAGE_MANAGER" = "distro" ]; then
        need_root "install packages with the system package manager"
        . /etc/os-release
        case "$ID" in
            ubuntu|debian)
                apt-get update
                apt-get install -y "$PKG"
                ;;
            fedora)
                dnf install -y "$PKG" --skip-unavailable
                ;;
            arch)
                pacman -S "$PKG"
                ;;
            opensuse*)
                zypper install -y "$PKG"
                ;;
        esac
    fi
fi

# If BIN_SOURCE contains only variant directories, build the ENTRIES list.
# Set ENTRIES explicitly for layouts that do not follow the PKG convention.
if [ -z "$ENTRIES" ] && [ -d "$BIN_SOURCE" ]; then
    _bindir_rel=$BIN_SOURCE
    case "$_bindir_rel" in
        "$PORTABLE_ROOT"/*) _bindir_rel=${_bindir_rel#"$PORTABLE_ROOT"/} ;;
    esac
    _has_files=0
    for _f in "$BIN_SOURCE"/*; do
        [ -f "$_f" ] && { _has_files=1; break; }
    done
    if [ "$_has_files" = "0" ]; then
        for _d in "$BIN_SOURCE"/*; do
            [ -d "$_d" ] || continue
            _variant=$(basename -- "$_d")

            _exe=""
            if [ -n "$PKG" ] && [ -x "$_d/$PKG-launcher" ]; then
                _exe="$PKG-launcher"
            elif [ -n "$PKG" ] && [ -x "$_d/$PKG" ]; then
                _exe="$PKG"
            else
                for _x in "$_d"/*; do
                    [ -f "$_x" ] && [ -x "$_x" ] || continue
                    _exe=$(basename -- "$_x")
                    break
                done
            fi
            [ -n "$_exe" ] || continue

            _desk=""
            if [ -n "$PKG" ] && [ -e "$PORTABLE_ROOT/${PKG}_${_variant}.desktop" ]; then
                _desk="${PKG}_${_variant}.desktop"
            elif [ -n "$PKG" ] && [ -e "$_d/${PKG}.desktop" ]; then
                _desk="${_bindir_rel}/${_variant}/${PKG}.desktop"
            fi

            _icon=""
            if [ -n "$PKG" ] && [ -e "$PORTABLE_ROOT/${PKG}.svg" ]; then
                _icon="${PKG}.svg"
            elif [ -n "$PKG" ] && [ -e "$_d/${PKG}.svg" ]; then
                _icon="${_bindir_rel}/${_variant}/${PKG}.svg"
            fi

            _id="${PKG:-$NAME}"
            ENTRIES="${ENTRIES}${_variant}|${_bindir_rel}/${_variant}|${_exe}|${_desk}|${_icon}|${_id}
"
        done
    fi
fi

# Defining BIN_TARGET
in_path() {
    case ":$PATH:" in
        *":$1:"*) return 0 ;;
        *)        return 1 ;;
    esac
}

# Prefer a writable directory in the user's home; fall back to the system PATH
if [ -z "$BIN_TARGET" ]; then
    for d in "$HOME/.local/bin" "$HOME/bin"; do
        if [ -d "$d" ]; then
            [ -w "$d" ] && { BIN_TARGET=$d; break; }
        elif mkdir -p "$d" 2>/dev/null; then
            BIN_TARGET=$d
            own_path "$BIN_TARGET"
            break
        fi
    done
fi
if [ -z "$BIN_TARGET" ]; then
    for d in "/usr/local/bin" "/usr/bin"; do
        [ -d "$d" ] && { BIN_TARGET=$d; break; }
    done
fi

[ -n "${BIN_TARGET:-}" ] || {
    printf '%s\n' "no writable bin directory found" >&2
    exit 1
}

# backup_target <path> [bak|number]
# Move path to path.bak, or to path1, path2, ... when the mode is number.
backup_target() {
    _tgt=$1
    _mode=${2:-number}
    [ -e "$_tgt" ] || [ -L "$_tgt" ] || return 0
    if [ "$_mode" = "bak" ]; then
        _bak="${_tgt}.bak"
        _i=1
        while [ -e "$_bak" ] || [ -L "$_bak" ]; do
            _bak="${_tgt}.bak.${_i}"
            _i=$((_i+1))
        done
    else
        _i=1
        while [ -e "$_tgt$_i" ] || [ -L "$_tgt$_i" ]; do
            _i=$((_i+1))
        done
        _bak="${_tgt}${_i}"
    fi
    mv "$_tgt" "$_bak" || need_root "back up $_tgt to $_bak"
}

# prepare_data_target <source> <target>
# An empty target directory is removed. Existing target data becomes the
# portable data when the source is empty; otherwise the target is backed up.
prepare_data_target() {
    _src=$1
    _tgt=$2

    [ -e "$_tgt" ] || [ -L "$_tgt" ] || return 0
    [ -L "$_tgt" ] && return 0
    [ -e "$_src" ] && [ "$_src" -ef "$_tgt" ] && return 0
    case "$_src/" in "$_tgt"/*) return 0 ;; esac
    case "$_tgt/" in "$_src"/*) return 0 ;; esac

    if [ -d "$_tgt" ] && [ -z "$(ls -A -- "$_tgt" 2>/dev/null)" ]; then
        rmdir -- "$_tgt" || need_root "remove the empty directory $_tgt"
        return 0
    fi

    [ "${BACKUP:-yes}" = "yes" ] || {
        printf 'Refusing to replace %s with BACKUP="no"\n' "$_tgt" >&2
        exit 1
    }

    if [ -d "$_tgt" ] && { [ ! -e "$_src" ] || { [ -d "$_src" ] && [ -z "$(ls -A -- "$_src" 2>/dev/null)" ]; }; }; then
        mkdir -p "$_src" || need_root "create $_src"
        cp -a -- "$_tgt/." "$_src/" || need_root "copy $_tgt to $_src"
        own_path "$_src"
        backup_target "$_tgt" bak
        return 0
    fi

    backup_target "$_tgt" number
}

# link_or_backup <source> <target> [bak|number]
# Symlink target -> source. Data backups use .bak; other targets use target1,
# target2, and so on. If target is a symlink resolving to the same inode as
# source, it's left as-is. If source is a broken symlink, any broken symlink
# at target is removed.
link_or_backup() {
    _src=$1
    _tgt=$2
    _mode=${3:-number}

    # Source doesn't exist at all - nothing to do
    [ -e "$_src" ] || [ -L "$_src" ] || return 1

    # Make sure the target's parent exists
    _dir=$(dirname -- "$_tgt")
    [ -d "$_dir" ] || mkdir -p "$_dir" || need_root "create $_dir"

    # Source is a broken symlink - clean up target if it's also a broken symlink
    if [ -L "$_src" ] && [ ! -e "$_src" ]; then
        if [ -L "$_tgt" ] && [ ! -e "$_tgt" ]; then
            rm -f -- "$_tgt" || need_root "remove the broken link $_tgt"
        fi
        return 0
    fi

    # Target doesn't exist - just link
    if [ ! -e "$_tgt" ] && [ ! -L "$_tgt" ]; then
        ln -sfn "$_src" "$_tgt" || need_root "link $_tgt"
        own "$_tgt"
        return 0
    fi

    # Target resolves to the same inode, even through another path - no-op
    if [ "$_tgt" -ef "$_src" ]; then
        return 0
    fi

    # Target is a broken symlink - remove and link
    if [ -L "$_tgt" ] && [ ! -e "$_tgt" ]; then
        rm -f -- "$_tgt" || need_root "remove the broken link $_tgt"
        ln -sfn "$_src" "$_tgt" || need_root "link $_tgt"
        own "$_tgt"
        return 0
    fi

    # Target exists (directory, file, or symlink pointing elsewhere) - back up and link
    [ "${BACKUP:-yes}" = "yes" ] || return 1
    backup_target "$_tgt" "$_mode"
    ln -sfn "$_src" "$_tgt" || need_root "link $_tgt"
    own "$_tgt"
    return 0
}

# Desktop entries and icons
if [ -n "$ENTRIES" ]; then
    install_entry() {
        _name=$1
        _bindir=$2
        _exec=$3
        _desktop=$4
        _icon=$5
        _icon_id=$6

        _icon_path=""
        if [ -n "$_icon" ]; then
            case "$_icon" in
                /*) _icon_path=$_icon ;;
                *) _icon_path="$PORTABLE_ROOT/$_icon" ;;
            esac
            [ -e "$_icon_path" ] || _icon_path=""
        fi
        if [ -z "$_icon_path" ] && [ -n "$ICON" ] && [ -e "$ICON" ]; then
            _icon_path=$ICON
        fi
        if [ -z "$_icon_id" ] && [ -n "$_icon_path" ]; then
            _icon_id=$(basename -- "$_icon_path")
            _icon_id=${_icon_id%.*}
        fi

        _icon_value=""
        if [ -n "$_icon_path" ] && [ -e "$_icon_path" ] && [ -n "$_icon_id" ]; then
            if [ "$ICON_METHOD" = "none" ]; then
                _icon_value=$_icon_path
            else
                _icon_ext=${_icon_path##*.}
                case "$_icon_ext" in
                    svg|png|xpm|jpg|jpeg) ;;
                    *) _icon_ext=png ;;
                esac
                case "$(file -b --mime-type -- "$_icon_path" 2>/dev/null)" in
                    image/svg+xml) _icon_ext=svg ;;
                    image/png) _icon_ext=png ;;
                esac
                _icon_dir="256x256/apps"
                [ "$_icon_ext" = "svg" ] && _icon_dir="scalable/apps"
                _icon_target=$ICON_TARGET
                [ -n "$_icon_target" ] || _icon_target="$HOME/.local/share/icons/hicolor/$_icon_dir"
                icon_install "$_icon_path" "$_icon_target/$_icon_id.$_icon_ext"
                icon_state_save "$_icon_id" "$_icon_ext" "$_icon_target"
                _icon_value=$_icon_id
                _entries_icon=1
            fi
        fi

        _cmd=""
        if [ -n "$_exec" ] && [ -d "$BIN_TARGET" ]; then
            case "$_bindir" in
                /*) _src=$_bindir/$_exec ;;
                *)  _src=$PORTABLE_ROOT/${_bindir:+$_bindir/}$_exec ;;
            esac
            _cmd="${PKG:-$NAME}-$_name"
            link_or_backup "$_src" "$BIN_TARGET/$_cmd" || _cmd=""
        fi

        if [ -n "$_desktop" ]; then
            _file=$_desktop
            case "$_file" in
                /*) ;;
                *) _file="$PORTABLE_ROOT/$_file" ;;
            esac
            if [ -e "$_file" ]; then
                _fields=$(awk -F'[[:space:]]+' '/^Exec=/ { for (i=1; i<=NF; i++) if ($i ~ /^%[fFuUdDnNickvm]$/) printf "%s ", $i }' "$_file" | sed 's/[[:space:]]*$//')
                if [ -n "$_cmd" ]; then
                    _exec_value=$_cmd
                    in_path "$BIN_TARGET" || _exec_value=$BIN_TARGET/$_cmd
                else
                    _exec_value=$SELF
                fi
                _exec_escaped=$(printf '%s\n' "$_exec_value" | sed 's/[\\&|]/\\&/g')
                case "$_exec_value" in
                    *[[:space:]]*) _exec_escaped="\"$_exec_escaped\"" ;;
                esac
                [ -n "$_cmd" ] || _exec_escaped="$_exec_escaped $_name"
                sed_in_place "$_file" "s|^Exec=.*|Exec=$_exec_escaped${_fields:+ $_fields}|"
                sed_in_place "$_file" "/^TryExec=/d"
                if [ -n "$_icon_value" ]; then
                    sed_in_place "$_file" "s|^Icon=.*|Icon=$_icon_value|"
                fi
                ln -sfn "$_file" "$DESKTOP_FILE_TARGET" || need_root "link $_file"
                own "$DESKTOP_FILE_TARGET/$(basename -- "$_file")"
            fi
        fi
    }

    mkdir -p "$DESKTOP_FILE_TARGET" || need_root "create $DESKTOP_FILE_TARGET"
    own_path "$DESKTOP_FILE_TARGET"
    mkdir -p "$BIN_TARGET" || need_root "create $BIN_TARGET"
    own_path "$BIN_TARGET"
    _entries_icon=0
    while IFS='|' read -r _name _bindir _exec _desktop _icon _icon_id; do
        [ -n "$_name" ] || continue
        install_entry "$_name" "$_bindir" "$_exec" "$_desktop" "$_icon" "$_icon_id"
    done <<EOF
$ENTRIES
EOF
    if [ "$_entries_icon" = "0" ] && [ -n "$ICON_ID" ] && [ -n "$ICON_TARGET" ] && [ -n "$_icon_ext" ] && [ "$ICON_METHOD" != "none" ]; then
        icon_restore "$ICON_TARGET" "$ICON_ID" "$_icon_default_ext" "$_icon_default_dir"
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1
        own "$HOME/.local/share/icons/hicolor/icon-theme.cache"
    fi
else
    # Link all .desktop files
    if [ -d "$DESKTOP_FILE_SOURCE" ]; then
        mkdir -p "$DESKTOP_FILE_TARGET" || need_root "create $DESKTOP_FILE_TARGET"
        own_path "$DESKTOP_FILE_TARGET"

        for file in "$DESKTOP_FILE_SOURCE"/*.desktop; do
            [ -e "$file" ] || continue
            if [ "$DESKTOP_REWRITE_EXEC" = "yes" ]; then
                _fields=$(awk -F'[[:space:]]+' '/^Exec=/ { for (i=1; i<=NF; i++) if ($i ~ /^%[fFuUdDnNickvm]$/) printf "%s ", $i }' "$file")
                _runner_escaped=$(printf '%s\n' "$SELF" | sed 's/[\\&|]/\\&/g')
                sed_in_place "$file" "s|^Exec=.*|Exec=\"$_runner_escaped\"${_fields:+ $_fields}|"
            fi
            ln -sfn "$file" "$DESKTOP_FILE_TARGET" || need_root "link $file"
            own "$DESKTOP_FILE_TARGET/$(basename "$file")"
        done
    fi

    # resolve desktop file icons
    if [ -n "$DESKTOP_FILE_NAME" ]; then
        if [ -n "$ICON" ] && [ -e "$ICON" ] && [ -n "$ICON_ID" ] && [ "$ICON_METHOD" != "none" ]; then
            _icon="$ICON_ID"
        elif [ -n "$ICON" ] && [ -e "$ICON" ]; then
            _icon="$ICON"
        else
            _icon="${NAME:-$PKG}"
        fi
        for file in "$DESKTOP_FILE_SOURCE"/"$DESKTOP_FILE_NAME"; do
            [ -e "$file" ] || continue
            if [ -n "$_icon" ]; then
                sed_in_place "$file" "s|^Icon=.*|Icon=$_icon|"
            fi
        done
    fi
fi

# Clean up broken symlinks if sources were removed
if [ -n "$BIN_SOURCE" ] && [ -d "$BIN_TARGET" ]; then
    for link in "$BIN_TARGET"/*; do
        [ -L "$link" ] || continue
        [ -e "$link" ] && continue
        _link_target=$(readlink "$link")
        case "$_link_target" in
            "$BIN_SOURCE"/*) rm -f "$link" ;;
            *)
                if [ -n "$_old_bin" ]; then
                    case "$_link_target" in "$_old_bin"/*) rm -f "$link" ;; esac
                fi
                ;;
        esac
    done
fi

# Link DAT_SOURCE to DAT_TARGET
if [ -n "$DAT_TARGET" ]; then
    if [ -L "$DAT_SOURCE" ] && [ ! -e "$DAT_SOURCE" ]; then
        printf 'Broken data source link: %s\n' "$DAT_SOURCE" >&2
        exit 1
    fi
    # A missing source with prior state was handled above. Reaching here with
    # a missing source means this is the first run.
    if [ ! -e "$DAT_SOURCE" ] && [ ! -L "$DAT_SOURCE" ]; then
        mkdir -p "$DAT_SOURCE" || need_root "create $DAT_SOURCE"
    fi
    own_path "$DAT_SOURCE"
    prepare_data_target "$DAT_SOURCE" "$DAT_TARGET"
    link_or_backup "$DAT_SOURCE" "$DAT_TARGET" bak
    source_state_save dat "$DAT_SOURCE"
fi

# Link binaries from BIN_SOURCE to BIN_TARGET
# BIN_SOURCE can be a directory or a single file
# BIN_TARGET can be a directory or a single file path
if [ -z "$ENTRIES" ] && [ -d "$BIN_SOURCE" ]; then
    # BIN_SOURCE is a directory - link all executables
    mkdir -p "$BIN_TARGET" || need_root "create $BIN_TARGET"
    own_path "$BIN_TARGET"
    for f in "$BIN_SOURCE"/*; do
        [ -f "$f" ] || continue
        [ -x "$f" ] || continue
        name=$(basename "$f")
        target="$BIN_TARGET/$name"
        link_or_backup "$f" "$target"
    done
elif [ -z "$ENTRIES" ] && { [ -f "$BIN_SOURCE" ] || [ -L "$BIN_SOURCE" ]; }; then
    # BIN_SOURCE is a single file
    if [ -d "$BIN_TARGET" ]; then
        # BIN_TARGET is a directory - link into it
        name=$(basename "$BIN_SOURCE")
        target="$BIN_TARGET/$name"
        link_or_backup "$BIN_SOURCE" "$target"
    else
        # BIN_TARGET is a file path - link directly
        link_or_backup "$BIN_SOURCE" "$BIN_TARGET"
    fi
fi

# Install the icon into the theme so desktop files can use Icon=<id>
if [ -z "$ENTRIES" ] && [ -n "$ICON" ] && [ -e "$ICON" ] && [ -n "$ICON_ID" ] && [ "$ICON_METHOD" != "none" ]; then
    icon_install "$ICON" "$ICON_TARGET/$ICON_ID.$_icon_ext"
    icon_state_save "$ICON_ID" "$_icon_ext" "$ICON_TARGET"
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1
        own "$HOME/.local/share/icons/hicolor/icon-theme.cache"
    fi
elif [ -z "$ENTRIES" ] && [ "$ICON_METHOD" != "none" ] && [ -n "$ICON_ID" ] && [ -n "$ICON_TARGET" ] && [ -n "$_icon_ext" ]; then
    # Source icon was removed: restore the archived icon, or drop the managed one
    icon_restore "$ICON_TARGET" "$ICON_ID" "$_icon_default_ext" "$_icon_default_dir"
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1
        own "$HOME/.local/share/icons/hicolor/icon-theme.cache"
    fi
fi

# gio metadata is per-user; skip it when running as root
if [ "$(id -u)" -ne 0 ] && command -v gio >/dev/null 2>&1; then
    if [ -n "$ICON" ] && [ -e "$ICON" ]; then
        _icon_uri="file://$(readlink -f -- "$ICON")"
        gio set -t string "$PORTABLE_ROOT" metadata::custom-icon "$_icon_uri"
        [ -n "$DAT_TARGET" ] && gio set -t string "$DAT_TARGET" metadata::custom-icon "$_icon_uri"
    else
        gio set -t unset "$PORTABLE_ROOT" metadata::custom-icon 2>/dev/null
        [ -n "$DAT_TARGET" ] && gio set -t unset "$DAT_TARGET" metadata::custom-icon 2>/dev/null
    fi
fi

# man linking
if [ -n "$MAN" ] && [ -d "$MAN" ]; then
    for src in "$MAN"/*.1; do
        [ -e "$src" ] || continue

        dst="/usr/share/man/man1/$(basename "$src")"

        if [ ! -e "$dst" ] || ! [ "$src" -ef "$dst" ]; then
            [ -w "/usr/share/man/man1" ] || need_root "link man pages into /usr/share/man/man1"
            ln -sfn "$src" "$dst" || need_root "link $dst"
        fi
    done
fi

# Optional external launcher, such as a chooser. It runs when no entry name
# is given and is bypassed by `run <entry>`.
if [ -n "$LAUNCHER" ]; then
    _launcher_arg=${1:-}
    _launcher_is_entry=0
    if [ -n "$_launcher_arg" ]; then
        while IFS='|' read -r _name _bindir _exec _desktop _icon _icon_id; do
            if [ "$_name" = "$_launcher_arg" ]; then
                _launcher_is_entry=1
                break
            fi
        done <<EOF
$ENTRIES
EOF
    fi
    if [ "$_launcher_is_entry" = "0" ]; then
        [ -x "$LAUNCHER" ] || {
            printf 'Missing launcher: %s\n' "$LAUNCHER" >&2
            exit 1
        }
        exec "$LAUNCHER" "$@"
    fi
fi

# Launch
if [ -n "$ENTRIES" ]; then
    _want=${1:-}
    _first_name=""
    _first_bindir=""
    _first_exec=""
    _default_bindir=""
    _default_exec=""
    _sel_bindir=""
    _sel_exec=""
    _sel=0
    while IFS='|' read -r _name _bindir _exec _desktop _icon _icon_id; do
        [ -n "$_name" ] || continue
        if [ -z "$_first_name" ]; then
            _first_name=$_name
            _first_bindir=$_bindir
            _first_exec=$_exec
        fi
        if [ -n "$DEFAULT_ENTRY" ] && [ "$_name" = "$DEFAULT_ENTRY" ]; then
            _default_bindir=$_bindir
            _default_exec=$_exec
        fi
        if [ -n "$_want" ] && [ "$_name" = "$_want" ]; then
            _sel_bindir=$_bindir
            _sel_exec=$_exec
            _sel=1
        fi
    done <<EOF
$ENTRIES
EOF

    if [ "$_sel" = "1" ]; then
        shift
    elif [ -n "$_default_bindir" ]; then
        _sel_bindir=$_default_bindir
        _sel_exec=$_default_exec
    else
        _sel_bindir=$_first_bindir
        _sel_exec=$_first_exec
    fi

    if [ -n "$_sel_bindir" ]; then
        case "$_sel_bindir" in
            /*) cd "$_sel_bindir" || exit 1 ;;
            *)  cd "$PORTABLE_ROOT/$_sel_bindir" || exit 1 ;;
        esac
    else
        cd "$PORTABLE_ROOT" || exit 1
    fi

    if [ -n "$_sel_exec" ]; then
        [ -x "./$_sel_exec" ] || {
            printf 'Missing executable: %s\n' "$_sel_exec" >&2
            exit 1
        }
        exec "./$_sel_exec" "$@"
    elif command -v app_run >/dev/null 2>&1; then
        app_run "$@"
        exit $?
    else
        printf 'No executable for entry: %s\n' "${_want:-$_first_name}" >&2
        exit 1
    fi
elif [ -n "$PKG" ] && command -v "$PKG" >/dev/null 2>&1; then
    nohup "$PKG" >/dev/null 2>&1 &
fi

# Kill the terminal if KILL_TERMINAL is yes and the runner was started from one
if [ "$KILL_TERMINAL" = "yes" ] && [ -t 0 ]; then
    kill -TERM "$PPID"
fi
