#!/bin/sh
# POSIX generic portable application script

# Directory where this script lives
SELF=$(readlink -f -- "$0" 2>/dev/null) || SELF=$0
PORTABLE_ROOT=$(cd -P -- "$(dirname -- "$SELF")" && command pwd -P)

# Keep user paths and ownership when run through sudo, doas, or another escalator
ORIG_USER=${SUDO_USER:-${DOAS_USER:-}}
ORIG_UID=${SUDO_UID:-${DOAS_UID:-}}
ORIG_GID=${SUDO_GID:-${DOAS_GID:-}}
if [ "$(id -u)" -eq 0 ] && [ -n "$ORIG_USER" ] && [ "$ORIG_USER" != "root" ]; then
    ORIG_HOME=$(getent passwd "$ORIG_USER" 2>/dev/null | cut -d: -f6)
    [ -n "$ORIG_HOME" ] || ORIG_HOME=$(awk -F: -v u="$ORIG_USER" '$1 == u { print $6; exit }' /etc/passwd)
    [ -n "$ORIG_HOME" ] && HOME="$ORIG_HOME"
fi
if [ -z "$ORIG_UID" ] && [ -n "$ORIG_USER" ]; then
    ORIG_UID=$(id -u "$ORIG_USER" 2>/dev/null)
    ORIG_GID=$(id -g "$ORIG_USER" 2>/dev/null)
fi

# Suggest an escalator without invoking it
if command -v sudo >/dev/null 2>&1; then
    ESCALATOR=sudo
elif command -v doas >/dev/null 2>&1; then
    ESCALATOR=doas
else
    ESCALATOR=""
fi

# Variables
PACKAGE_MANAGER="auto"
PKG=""
NAME="$PKG"
DAT_SOURCE="$PORTABLE_ROOT/dat"
DAT_TARGET="" 
BACKUP="yes"
BIN_SOURCE="$PORTABLE_ROOT/bin"
BIN_TARGET=""
DESKTOP_FILE_NAME=""
DESKTOP_FILE_SOURCE="$PORTABLE_ROOT"
DESKTOP_FILE_TARGET="$HOME/.local/share/applications"
DESKTOP_REWRITE_EXEC="yes"
ICON_NAME=""
ICON_ID=""
ICON_SOURCE="$PORTABLE_ROOT"
ICON_TARGET=""
ICON_METHOD="copy"
ICON=""
CACHE_SOURCE="" 
CACHE_TARGET="" 
MAN="$BIN_SOURCE"
KILL_TERMINAL="yes"

# Fail instead of calling sudo
need_root() {
    if [ "$(id -u)" -eq 0 ]; then
        printf '%s\n' "Failed: $*" >&2
    else
        printf '%s\n' "This needs root: $*" >&2
        printf '%s\n' "Re-run as root: ${ESCALATOR:+$ESCALATOR }$0" >&2
    fi
    exit 1
}

# Keep files under the invoking user's home owned by that user
own() {
    [ "$(id -u)" -eq 0 ] && [ -n "$ORIG_UID" ] && [ -n "$ORIG_GID" ] || return 0
    case "$1" in
        "$HOME"/*) chown -h "$ORIG_UID:$ORIG_GID" "$1" 2>/dev/null || true ;;
    esac
}

# Keep the created parent chain under the invoking user's home owned by that user
own_path() {
    [ "$(id -u)" -eq 0 ] && [ -n "$ORIG_UID" ] && [ -n "$ORIG_GID" ] || return 0
    _p=$1
    while [ -n "$_p" ] && [ "$_p" != "/" ] && [ "$_p" != "$HOME" ]; do
        case "$_p" in
            "$HOME"/*) chown -h "$ORIG_UID:$ORIG_GID" "$_p" 2>/dev/null || true ;;
            *) break ;;
        esac
        _p=$(dirname -- "$_p")
    done
}

# sed -i that keeps the original owner (useful when run with sudo)
sed_in_place() {
    _file=$1
    shift
    _uid=$(stat -c %u -- "$_file" 2>/dev/null)
    _gid=$(stat -c %g -- "$_file" 2>/dev/null)
    sed -i "$@" "$_file" || need_root "edit $_file"
    if [ "$(id -u)" -eq 0 ] && [ -n "$_uid" ] && [ -n "$_gid" ]; then
        chown "$_uid:$_gid" -- "$_file" 2>/dev/null
    fi
}

# First image in ICON_SOURCE becomes the icon; ICON_NAME pins one
if [ -z "$ICON_NAME" ] && [ -d "$ICON_SOURCE" ]; then
    for f in "$ICON_SOURCE"/*; do
        [ -f "$f" ] || continue
        case "$(file -b --mime-type -- "$f" 2>/dev/null)" in
            image/*) ICON_NAME=${f##*/}; break ;;
        esac
    done
fi
if [ -n "$ICON_NAME" ]; then
    ICON="$ICON_SOURCE/$ICON_NAME"
    if [ -z "$ICON_ID" ]; then
        ICON_ID=${ICON_NAME%.*}
    fi
    case "$ICON_ID" in
        *.svg|*.png|*.xpm|*.jpg|*.jpeg) ICON_ID=${ICON_ID%.*} ;;
    esac
    _icon_ext=${ICON_NAME##*.}
    case "$_icon_ext" in
        svg|png|xpm|jpg|jpeg) ;;
        *) _icon_ext=png ;;
    esac
    case "$(file -b --mime-type -- "$ICON" 2>/dev/null)" in
        image/svg+xml) _icon_ext=svg ;;
        image/png) _icon_ext=png ;;
    esac
    case "$_icon_ext" in
        svg) _icon_dir="scalable/apps" ;;
        *) _icon_dir="256x256/apps" ;;
    esac
    if [ -z "$ICON_TARGET" ]; then
        ICON_TARGET="$HOME/.local/share/icons/hicolor/$_icon_dir"
    fi
fi

# Check whether any target path is on a filesystem without POSIX permission support
paths="
$DAT_SOURCE
$BIN_SOURCE
$DESKTOP_FILE_SOURCE
$ICON_SOURCE
$CACHE_SOURCE
$MAN
"

# Language-based directory name assumptions
LANG_INFERRING_BIN="bin binary binaries binarios executables executável executáveis executaveis executavel"
LANG_INFERRING_DATA="dat data dados config user"

# Check whether any target path is on a filesystem without POSIX permission support
printf '%s\n' "$paths" | while IFS= read -r path; do
    [ -z "$path" ] && continue

    fstype=$(findmnt -n -o FSTYPE -T "$path" 2>/dev/null) || continue

    case "$fstype" in
        ntfs|ntfs3|fuseblk|vfat|msdos|exfat)
            notify-send "Warning" "'$path' is on a $fstype filesystem."
            kill -TERM "$PPID"
            ;;
    esac
done

# Install the package if not already installed
# PACKAGE_MANAGER: "auto"/"native" tries pkgcli > pkcon > distro; "distro" uses only the distro package manager
if [ -n "$PKG" ]; then
    if command -v "$PKG" >/dev/null 2>&1; then
        : # already installed
    elif { [ "$PACKAGE_MANAGER" = "auto" ] || [ "$PACKAGE_MANAGER" = "native" ]; } && command -v pkgcli >/dev/null 2>&1; then
        pkgcli install "$PKG"
    elif { [ "$PACKAGE_MANAGER" = "auto" ] || [ "$PACKAGE_MANAGER" = "native" ]; } && command -v pkcon >/dev/null 2>&1; then
        pkcon install "$PKG"
    elif [ "$PACKAGE_MANAGER" = "auto" ] || [ "$PACKAGE_MANAGER" = "native" ] || [ "$PACKAGE_MANAGER" = "distro" ]; then
        need_root "install packages with the system package manager"
        . /etc/os-release
        case "$ID" in
            ubuntu|debian)
                apt-get update
                apt-get install -y "$PKG"
                ;;
            fedora)
                dnf install -y "$PKG" --skip-unavailable
                ;;
            arch)
                pacman -S "$PKG"
                ;;
            opensuse*)
                zypper install -y "$PKG"
                ;;
        esac
    fi
fi

# Link all .desktop files
if [ -d "$DESKTOP_FILE_SOURCE" ]; then
    mkdir -p "$DESKTOP_FILE_TARGET" || need_root "create $DESKTOP_FILE_TARGET"
    own_path "$DESKTOP_FILE_TARGET"

    for file in "$DESKTOP_FILE_SOURCE"/*.desktop; do
        [ -e "$file" ] || continue
        if [ "$DESKTOP_REWRITE_EXEC" = "yes" ]; then
            _fields=$(awk -F'[[:space:]]+' '/^Exec=/ { for (i=1; i<=NF; i++) if ($i ~ /^%[fFuUdDnNickvm]$/) printf "%s ", $i }' "$file")
            _runner_escaped=$(printf '%s\n' "$SELF" | sed 's/[\\&|]/\\&/g')
            sed_in_place "$file" "s|^Exec=.*|Exec=\"$_runner_escaped\"${_fields:+ $_fields}|"
        fi
        ln -sfn "$file" "$DESKTOP_FILE_TARGET" || need_root "link $file"
        own "$DESKTOP_FILE_TARGET/$(basename "$file")"
    done
fi

# resolve desktop file icons
if [ -n "$DESKTOP_FILE_NAME" ]; then
    if [ -n "$ICON" ] && [ -e "$ICON" ] && [ -n "$ICON_ID" ] && [ "$ICON_METHOD" != "none" ]; then
        _icon="$ICON_ID"
    elif [ -n "$ICON" ] && [ -e "$ICON" ]; then
        _icon="$ICON"
    else
        _icon="${NAME:-$PKG}"
    fi
    for file in "$DESKTOP_FILE_SOURCE"/"$DESKTOP_FILE_NAME"; do
        [ -e "$file" ] || continue
        if [ -n "$_icon" ]; then
            sed_in_place "$file" "s|^Icon=.*|Icon=$_icon|"
        fi
    done
fi

# Defining BIN_TARGET
in_path() {
    case ":$PATH:" in
        *":$1:"*) return 0 ;;
        *)        return 1 ;;
    esac
}

if [ -z "$BIN_TARGET" ]; then
    for d in "$HOME/.local/bin" "$HOME/bin" "/usr/local/bin" "/usr/bin"; do
        if in_path "$d"; then
            BIN_TARGET=$d
            break
        fi
    done
fi

# Fail early if nothing in PATH matches
[ -n "${BIN_TARGET:-}" ] || {
    printf '%s\n' "no PATH directory found among candidates" >&2
    exit 1
}

# link_or_backup <source> <target>
# Symlink target -> source. Backs up anything that would be overwritten as .bak.
# If target is a symlink resolving to the same inode as source, it's left as-is.
# If source is a broken symlink, any broken symlink at target is removed.
link_or_backup() {
    _src=$1
    _tgt=$2

    # Source doesn't exist at all - nothing to do
    [ -e "$_src" ] || [ -L "$_src" ] || return 1

    # Make sure the target's parent exists
    _dir=$(dirname -- "$_tgt")
    [ -d "$_dir" ] || mkdir -p "$_dir" || need_root "create $_dir"

    # Source is a broken symlink - clean up target if it's also a broken symlink
    if [ -L "$_src" ] && [ ! -e "$_src" ]; then
        if [ -L "$_tgt" ] && [ ! -e "$_tgt" ]; then
            rm -f "$_tgt" || need_root "remove the broken link $_tgt"
        fi
        return 0
    fi

    # Target doesn't exist - just link
    if [ ! -e "$_tgt" ] && [ ! -L "$_tgt" ]; then
        ln -sfn "$_src" "$_tgt" || need_root "link $_tgt"
        own "$_tgt"
        return 0
    fi

    # Target is a symlink that resolves to the same inode - no-op
    if [ -L "$_tgt" ] && [ "$_tgt" -ef "$_src" ]; then
        return 0
    fi

    # Target is a broken symlink - remove and link
    if [ -L "$_tgt" ] && [ ! -e "$_tgt" ]; then
        rm "$_tgt" || need_root "remove the broken link $_tgt"
        ln -sfn "$_src" "$_tgt" || need_root "link $_tgt"
        own "$_tgt"
        return 0
    fi

    # Target exists (directory, file, or symlink pointing elsewhere) - back up and link
    [ "${BACKUP:-yes}" = "yes" ] || return 1
    _bak="${_tgt}.bak"
    _i=1
    while [ -e "$_bak" ] || [ -L "$_bak" ]; do
        _bak="${_tgt}.bak.${_i}"
        _i=$((_i+1))
    done
    mv "$_tgt" "$_bak" || need_root "back up $_tgt to $_bak"
    ln -sfn "$_src" "$_tgt" || need_root "link $_tgt"
    own "$_tgt"
    return 0
}

# Clean up broken symlinks if sources were removed
if [ -n "$DAT_TARGET" ] && [ -L "$DAT_TARGET" ] && [ ! -e "$DAT_TARGET" ]; then
    rm -f "$DAT_TARGET"
fi

if [ -d "$BIN_TARGET" ]; then
    for link in "$BIN_TARGET"/*; do
        [ -L "$link" ] || continue
        [ -e "$link" ] && continue
        case "$(readlink "$link")" in
            "$BIN_SOURCE"/*) rm -f "$link" ;;
        esac
    done
fi

# Link DAT_SOURCE to DAT_TARGET
if [ -n "$DAT_TARGET" ]; then
    link_or_backup "$DAT_SOURCE" "$DAT_TARGET"
fi

# Link binaries from BIN_SOURCE to BIN_TARGET
# BIN_SOURCE can be a directory or a single file
# BIN_TARGET can be a directory or a single file path
if [ -d "$BIN_SOURCE" ]; then
    # BIN_SOURCE is a directory - link all executables
    mkdir -p "$BIN_TARGET" || need_root "create $BIN_TARGET"
    own_path "$BIN_TARGET"
    for f in "$BIN_SOURCE"/*; do
        [ -f "$f" ] || continue
        [ -x "$f" ] || continue
        name=$(basename "$f")
        target="$BIN_TARGET/$name"
        link_or_backup "$f" "$target"
    done
elif [ -f "$BIN_SOURCE" ] || [ -L "$BIN_SOURCE" ]; then
    # BIN_SOURCE is a single file
    if [ -d "$BIN_TARGET" ]; then
        # BIN_TARGET is a directory - link into it
        name=$(basename "$BIN_SOURCE")
        target="$BIN_TARGET/$name"
        link_or_backup "$BIN_SOURCE" "$target"
    else
        # BIN_TARGET is a file path - link directly
        link_or_backup "$BIN_SOURCE" "$BIN_TARGET"
    fi
fi

# Install the icon into the theme so desktop files can use Icon=<id>
if [ -n "$ICON" ] && [ -e "$ICON" ] && [ -n "$ICON_ID" ] && [ "$ICON_METHOD" != "none" ]; then
    mkdir -p "$ICON_TARGET" || need_root "create $ICON_TARGET"
    own_path "$ICON_TARGET"
    if [ "$ICON_METHOD" = "link" ]; then
        ln -sfn "$ICON" "$ICON_TARGET/$ICON_ID.$_icon_ext" || need_root "link $ICON_TARGET/$ICON_ID.$_icon_ext"
    else
        rm -f "$ICON_TARGET/$ICON_ID.$_icon_ext" || need_root "replace $ICON_TARGET/$ICON_ID.$_icon_ext"
        cp -f "$ICON" "$ICON_TARGET/$ICON_ID.$_icon_ext" || need_root "copy $ICON to $ICON_TARGET"
    fi
    own "$ICON_TARGET/$ICON_ID.$_icon_ext"
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1
        own "$HOME/.local/share/icons/hicolor/icon-theme.cache"
    fi
elif [ "$ICON_METHOD" != "none" ] && [ -n "$ICON_ID" ] && [ -n "$ICON_TARGET" ]; then
    # Source icon was removed: drop the managed theme icon too
    for _ext in svg png xpm jpg jpeg; do
        rm -f "$ICON_TARGET/$ICON_ID.$_ext" 2>/dev/null
    done
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1
        own "$HOME/.local/share/icons/hicolor/icon-theme.cache"
    fi
fi

# gio metadata is per-user; skip it when running as root
if [ "$(id -u)" -ne 0 ] && command -v gio >/dev/null 2>&1; then
    if [ -n "$ICON" ] && [ -e "$ICON" ]; then
        _icon_uri="file://$(readlink -f -- "$ICON")"
        gio set -t string "$PORTABLE_ROOT" metadata::custom-icon "$_icon_uri"
        [ -n "$DAT_TARGET" ] && gio set -t string "$DAT_TARGET" metadata::custom-icon "$_icon_uri"
    else
        gio set -t unset "$PORTABLE_ROOT" metadata::custom-icon 2>/dev/null
        [ -n "$DAT_TARGET" ] && gio set -t unset "$DAT_TARGET" metadata::custom-icon 2>/dev/null
    fi
fi

# man linking
if [ -n "$MAN" ] && [ -d "$MAN" ]; then
    for src in "$MAN"/*.1; do
        [ -e "$src" ] || continue

        dst="/usr/share/man/man1/$(basename "$src")"

        if [ ! -e "$dst" ] || ! [ "$src" -ef "$dst" ]; then
            [ -w "/usr/share/man/man1" ] || need_root "link man pages into /usr/share/man/man1"
            ln -sfn "$src" "$dst" || need_root "link $dst"
        fi
    done
fi

# Run the application
if [ -n "$PKG" ] && command -v "$PKG" >/dev/null 2>&1; then
    nohup "$PKG" >/dev/null 2>&1 &
fi

# Kill the terminal if KILL_TERMINAL is yes and the runner was started from one
if [ "$KILL_TERMINAL" = "yes" ] && [ -t 0 ]; then
    kill -TERM "$PPID"
fi
